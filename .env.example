BASE_DIR=./data
PORT=3000
HELIX_URL=http://127.0.0.1:6969
LOG_LEVEL=info

# Interpreter the API spawns for the deterministic FITS analysis chain
# (scripts/analyze_coronal_window.py and siblings; see requirements.txt).
# Defaults to `python` on PATH. Set this when the PATH resolves to a
# distribution without the scientific stack (e.g. the Python bundled with
# Inkscape or the WindowsApps stub), otherwise every local diagnostic fails
# with ModuleNotFoundError at run time.
# PYTHON_EXECUTABLE=C:\path\to\python.exe

# Free scholarly metadata federation. OpenAlex and Crossref work without keys;
# a free OpenAlex key and a contact email only improve quota/etiquette.
LITERATURE_ONLINE_ENABLED=true
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Keep browser REST requests and SSE streams on the same API origin. The
# server-side value is used by Next.js rewrites; NEXT_PUBLIC_API_BASE_URL is
# embedded in the browser bundle and must point at the same service.
API_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Required for encrypting credentials in data/global.sqlite.
# Replace this with a stable, local-only secret before using /api/credentials
# or the Settings page. Do not commit the resulting .env file.
CREDENTIAL_ENCRYPTION_KEY=__SET_A_STABLE_LOCAL_SECRET__
